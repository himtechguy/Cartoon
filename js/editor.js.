const Editor = {
  selectedObject: null,
  currentSceneId: null,
  tool: "select",

  init() {
    this.bind();
    this.loadScene();
  },

  bind() {
    const sceneSelect = document.getElementById("sceneSelect");

    if (sceneSelect) {
      sceneSelect.addEventListener("change", () => {
        this.currentSceneId = sceneSelect.value;
        this.selectedObject = null;
        this.render();
      });
    }

    const stage = document.getElementById("stage");

    if (stage) {
      stage.addEventListener("pointerdown", event => {
        if (
          event.target === stage ||
          event.target.id === "stageBg" ||
          event.target.id === "stageObjects"
        ) {
          this.selectedObject = null;
          this.render();
        }
      });
    }
  },

  getEpisode() {
    return project.episodes?.[0] || null;
  },

  getScene() {
    const episode = this.getEpisode();

    if (!episode?.scenes?.length) return null;

    let scene = episode.scenes.find(
      item => item.id === this.currentSceneId
    );

    if (!scene) {
      scene = episode.scenes[0];
      this.currentSceneId = scene.id;
    }

    if (!scene.objects) scene.objects = [];
    if (!scene.dialogue) scene.dialogue = [];
    if (!scene.titles) scene.titles = [];

    return scene;
  },

  loadScene() {
    const episode = this.getEpisode();
    const select = document.getElementById("sceneSelect");

    if (!episode?.scenes?.length) {
      if (select) select.innerHTML = "";
      this.render();
      return;
    }

    if (
      !this.currentSceneId ||
      !episode.scenes.some(
        scene => scene.id === this.currentSceneId
      )
    ) {
      this.currentSceneId = episode.scenes[0].id;
    }

    if (select) {
      select.innerHTML = "";

      episode.scenes.forEach(scene => {
        const option = document.createElement("option");
        option.value = scene.id;
        option.textContent = scene.name || "Scene";
        select.appendChild(option);
      });

      select.value = this.currentSceneId;
    }

    this.selectedObject = null;
    this.render();
  },

  render() {
    const scene = this.getScene();

    const stage = document.getElementById("stageObjects");
    const background = document.getElementById("stageBg");

    if (!stage || !scene) return;

    stage.innerHTML = "";

    if (background) {
      const bg = scene.background || {};
      background.style.background = bg.color || "#18202b";

      if (bg.image) {
        background.style.backgroundImage =
          `url("${bg.image}")`;

        background.style.backgroundSize = "cover";
        background.style.backgroundPosition = "center";
      } else {
        background.style.backgroundImage = "none";
      }
    }

    if (!scene.objects) scene.objects = [];

    scene.objects.forEach(object => {
      this.renderObject(object);
    });

    this.renderInspector();

    if (typeof Camera !== "undefined") {
      Camera.apply(
        typeof Timeline !== "undefined"
          ? Timeline.currentTime
          : 0
      );
    }
  },

  renderObject(object) {
    const container = document.getElementById("stageObjects");

    if (!container) return;

    const element = document.createElement("div");

    element.className = "stage-object";
    element.dataset.id = object.id;

    if (
      this.selectedObject &&
      this.selectedObject.id === object.id
    ) {
      element.classList.add("selected");
    }

    let content = "";

    if (object.type === "character") {
      const character = project.characters?.find(
        character => character.id === object.characterId
      );

      const emoji =
        character?.name === "Takue"
          ? "🧑🏾"
          : "👤";

      content = `
        <div class="object-avatar">${emoji}</div>
        <span>${this.escape(
          character?.name || "Character"
        )}</span>
      `;
    }

    if (object.type === "prop") {
      const propIcon = this.getPropIcon(object.name);

      content = `
        <div class="object-avatar">${propIcon}</div>
        <span>${this.escape(object.name || "Prop")}</span>
      `;
    }

    if (object.type === "dialogue") {
      content = `
        <div class="speech-bubble">
          ${this.escape(object.text || "...")}
        </div>
      `;
    }

    element.innerHTML = content;

    const x = Number(object.x ?? 50);
    const y = Number(object.y ?? 50);
    const scale = Number(object.scale ?? 1);
    const rotation = Number(object.rotation ?? 0);
    const opacity = Number(object.opacity ?? 1);

    element.style.left = `${x}%`;
    element.style.top = `${y}%`;

    element.style.opacity = opacity;

    element.style.transform =
      `translate(-50%, -50%) scale(${scale}) rotate(${rotation}deg)`;

    element.addEventListener("pointerdown", event => {
      event.stopPropagation();

      this.selectObject(object.id);

      if (this.tool === "move") {
        this.startDrag(event, object, element);
      }
    });

    container.appendChild(element);
  },

  getPropIcon(name) {
    const icons = {
      Phone: "📱",
      Chair: "🪑",
      Table: "🪑",
      Car: "🚗",
      Door: "🚪",
      Bed: "🛏️",
      TV: "📺",
      Cup: "☕",
      Bag: "👜",
      Computer: "💻",
      Food: "🍔",
      Money: "💵",
      Books: "📚"
    };

    return icons[name] || "📦";
  },

  selectObject(id) {
    const scene = this.getScene();

    if (!scene) return;

    this.selectedObject =
      scene.objects.find(
        object => object.id === id
      ) || null;

    this.render();
  },

  addCharacter(characterId) {
    const scene = this.getScene();

    if (!scene) return;

    const characters = project.characters || [];

    if (!characters.length) {
      alert("Create a character first.");
      return;
    }

    let character;

    if (characterId) {
      character = characters.find(
        item => item.id === characterId
      );
    }

    if (!character) {
      const names = characters
        .map(item => item.name)
        .join("\n");

      const selectedName = prompt(
        `Character name:\n\n${names}`
      );

      if (!selectedName) return;

      character =
        characters.find(
          item =>
            item.name.toLowerCase() ===
            selectedName.trim().toLowerCase()
        ) || characters[0];
    }

    UndoRedo.saveState();

    const object = {
      id: "obj_" + Date.now(),

      type: "character",

      characterId: character.id,

      x: 50,
      y: 55,

      scale: 1,
      rotation: 0,
      opacity: 1,

      pose: character.pose || "standing",
      expression: character.expression || "normal",

      flipX: false,
      flipY: false,

      zIndex: scene.objects.length,

      keyframes: []
    };

    scene.objects.push(object);

    this.selectedObject = object;

    saveProject();
    this.render();

    if (typeof Timeline !== "undefined") {
      Timeline.render();
    }

    if (typeof App !== "undefined") {
      App.toast("Character added");
    }
  },

  addProp(name) {
    const scene = this.getScene();

    if (!scene) return;

    let propName = name;

    if (!propName) {
      propName = prompt(
        "Enter prop name:",
        "Chair"
      );
    }

    if (!propName || !propName.trim()) return;

    UndoRedo.saveState();

    const object = {
      id: "obj_" + Date.now(),

      type: "prop",

      name: propName.trim(),

      x: 50,
      y: 55,

      scale: 1,
      rotation: 0,
      opacity: 1,

      flipX: false,
      flipY: false,

      zIndex: scene.objects.length,

      keyframes: []
    };

    scene.objects.push(object);

    this.selectedObject = object;

    saveProject();
    this.render();

    if (typeof Timeline !== "undefined") {
      Timeline.render();
    }

    if (typeof App !== "undefined") {
      App.toast("Prop added");
    }
  },

  addDialogue() {
    const scene = this.getScene();

    if (!scene) return;

    const text = prompt("Enter dialogue:");

    if (!text || !text.trim()) return;

    UndoRedo.saveState();

    const object = {
      id: "obj_" + Date.now(),

      type: "dialogue",

      text: text.trim(),

      x: 50,
      y: 25,

      scale: 1,
      rotation: 0,
      opacity: 1,

      start: 0,
      end: 3,

      zIndex: scene.objects.length,

      keyframes: []
    };

    scene.objects.push(object);

    this.selectedObject = object;

    saveProject();
    this.render();

    if (typeof Timeline !== "undefined") {
      Timeline.render();
    }

    if (typeof App !== "undefined") {
      App.toast("Dialogue added");
    }
  },

  deleteSelected() {
    const scene = this.getScene();

    if (!scene || !this.selectedObject) return;

    UndoRedo.saveState();

    scene.objects =
      scene.objects.filter(
        object =>
          object.id !== this.selectedObject.id
      );

    this.selectedObject = null;

    saveProject();
    this.render();

    if (typeof Timeline !== "undefined") {
      Timeline.render();
    }
  },

  duplicateSelected() {
    const scene = this.getScene();

    if (!scene || !this.selectedObject) return;

    UndoRedo.saveState();

    const copy = JSON.parse(
      JSON.stringify(this.selectedObject)
    );

    copy.id = "obj_" + Date.now();

    copy.x = Math.min(
      95,
      Number(copy.x ?? 50) + 5
    );

    copy.zIndex = scene.objects.length;

    scene.objects.push(copy);

    this.selectedObject = copy;

    saveProject();
    this.render();

    if (typeof Timeline !== "undefined") {
      Timeline.render();
    }
  },

  bringForward() {
    const scene = this.getScene();

    if (!scene || !this.selectedObject) return;

    const index =
      scene.objects.findIndex(
        object =>
          object.id === this.selectedObject.id
      );

    if (index < 0 || index >= scene.objects.length - 1) {
      return;
    }

    UndoRedo.saveState();

    const next = scene.objects[index + 1];

    scene.objects[index + 1] = this.selectedObject;
    scene.objects[index] = next;

    this.updateLayerIndexes(scene);

    saveProject();
    this.render();
  },

  sendBackward() {
    const scene = this.getScene();

    if (!scene || !this.selectedObject) return;

    const index =
      scene.objects.findIndex(
        object =>
          object.id === this.selectedObject.id
      );

    if (index <= 0) return;

    UndoRedo.saveState();

    const previous = scene.objects[index - 1];

    scene.objects[index - 1] = this.selectedObject;
    scene.objects[index] = previous;

    this.updateLayerIndexes(scene);

    saveProject();
    this.render();
  },

  updateLayerIndexes(scene) {
    scene.objects.forEach(
      (object, index) => {
        object.zIndex = index;
      }
    );
  },

  flipHorizontal() {
    if (!this.selectedObject) return;

    UndoRedo.saveState();

    this.selectedObject.flipX =
      !this.selectedObject.flipX;

    saveProject();
    this.render();
  },

  setPose(pose) {
    if (!this.selectedObject) return;

    UndoRedo.saveState();

    this.selectedObject.pose = pose;

    saveProject();
    this.render();
  },

  setExpression(expression) {
    if (!this.selectedObject) return;

    UndoRedo.saveState();

    this.selectedObject.expression =
      expression;

    saveProject();
    this.render();
  },

  startDrag(event, object, element) {
    const stage =
      document.getElementById("stage");

    if (!stage) return;

    const rect =
      stage.getBoundingClientRect();

    const startX = event.clientX;
    const startY = event.clientY;

    const originalX = Number(object.x ?? 50);
    const originalY = Number(object.y ?? 50);

    UndoRedo.saveState();

    const move = e => {
      const dx =
        ((e.clientX - startX) /
          rect.width) *
        100;

      const dy =
        ((e.clientY - startY) /
          rect.height) *
        100;

      object.x = Math.max(
        0,
        Math.min(100, originalX + dx)
      );

      object.y = Math.max(
        0,
        Math.min(100, originalY + dy)
      );

      element.style.left =
        `${object.x}%`;

      element.style.top =
        `${object.y}%`;
    };

    const stop = () => {
      document.removeEventListener(
        "pointermove",
        move
      );

      document.removeEventListener(
        "pointerup",
        stop
      );

      saveProject();

      this.render();
    };

    document.addEventListener(
      "pointermove",
      move
    );

    document.addEventListener(
      "pointerup",
      stop
    );
  },

  setTool(tool) {
    this.tool = tool;

    document
      .querySelectorAll("[data-tool]")
      .forEach(button => {
        button.classList.toggle(
          "active",
          button.dataset.tool === tool
        );
      });
  },

  updateSelected(property, value) {
    if (!this.selectedObject) return;

    UndoRedo.saveState();

    const numeric =
      Number(value);

    this.selectedObject[property] =
      Number.isFinite(numeric)
        ? numeric
        : value;

    saveProject();
    this.render();
  },

  renderInspector() {
    const panel =
      document.getElementById(
        "inspectorContent"
      );

    if (!panel) return;

    const object =
      this.selectedObject;

    if (!object) {
      panel.innerHTML =
        "<p>Select an object on the stage.</p>";

      return;
    }

    const poseOptions = [
      "standing",
      "walking",
      "running",
      "sitting",
      "lying",
      "talking",
      "pointing",
      "waving",
      "dancing",
      "fighting"
    ];

    const expressionOptions = [
      "normal",
      "happy",
      "sad",
      "angry",
      "scared",
      "shocked",
      "laughing",
      "crying",
      "confused",
      "thinking",
      "smirking"
    ];

    panel.innerHTML = `

      <div class="inspector-group">
        <label>X</label>
        <input
          type="number"
          min="0"
          max="100"
          value="${object.x ?? 50}"
          onchange="Editor.updateSelected('x', this.value)"
        >
      </div>

      <div class="inspector-group">
        <label>Y</label>
        <input
          type="number"
          min="0"
          max="100"
          value="${object.y ?? 50}"
          onchange="Editor.updateSelected('y', this.value)"
        >
      </div>

      <div class="inspector-group">
        <label>Scale</label>
        <input
          type="number"
          min="0.1"
          step="0.1"
          value="${object.scale ?? 1}"
          onchange="Editor.updateSelected('scale', this.value)"
        >
      </div>

      <div class="inspector-group">
        <label>Rotation</label>
        <input
          type="number"
          value="${object.rotation ?? 0}"
          onchange="Editor.updateSelected('rotation', this.value)"
        >
      </div>

      <div class="inspector-group">
        <label>Opacity</label>
        <input
          type="number"
          min="0"
          max="1"
          step="0.05"
          value="${object.opacity ?? 1}"
          onchange="Editor.updateSelected('opacity', this.value)"
        >
      </div>

      ${
        object.type === "character"
          ? `
            <div class="inspector-group">
              <label>Pose</label>

              <select
                onchange="Editor.setPose(this.value)"
              >
                ${poseOptions.map(
                  pose => `
                    <option
                      value="${pose}"
                      ${
                        object.pose === pose
                          ? "selected"
                          : ""
                      }
                    >
                      ${pose}
                    </option>
                  `
                ).join("")}
              </select>
            </div>

            <div class="inspector-group">
              <label>Expression</label>

              <select
                onchange="Editor.setExpression(this.value)"
              >
                ${expressionOptions.map(
                  expression => `
                    <option
                      value="${expression}"
                      ${
                        object.expression === expression
                          ? "selected"
                          : ""
                      }
                    >
                      ${expression}
                    </option>
                  `
                ).join("")}
              </select>
            </div>

            <button onclick="Editor.flipHorizontal()">
              ↔ Flip
            </button>
          `
          : ""
      }

      <div class="inspector-actions">

        <button onclick="Editor.bringForward()">
          Bring Forward
        </button>

        <button onclick="Editor.sendBackward()">
          Send Back
        </button>

        <button onclick="Editor.duplicateSelected()">
          Duplicate
        </button>

        <button
          class="danger-btn"
          onclick="Editor.deleteSelected()"
        >
          Delete
        </button>

      </div>
    `;
  },

  escape(text) {
    return String(text)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }
};
